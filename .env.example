# ViewFlare configuration reference
#
# ViewFlare runs as a Cloudflare Worker, which does not read a .env file. This
# file exists to document every variable the code actually reads, and where each
# one belongs.
#
#   Non-secret values  ->  the [vars] block in wrangler.toml, deployed with the
#                          Worker by `npm run deploy`.
#   Secrets            ->  `npx wrangler secret put NAME`, which prompts you and
#                          sends the value straight to Cloudflare.
#   Local dev only     ->  copy the lines you want into `.dev.vars`, which
#                          wrangler reads for `npm run dev`. It is gitignored.
#
# Nothing here is required. Every variable has a working default.

## Secret. Never put this in wrangler.toml or in any committed file.
## Deployed:  npx wrangler secret put ADMIN_PASSWORD
## Local dev: a line in .dev.vars
# ADMIN_PASSWORD=

## Admin console and dashboard. "true" to enable. Default off.
ENABLE_ADMIN=true

## Per-request usage rows in usage_stats. Costs a write on every request, so it
## is off unless you want it. Default off.
ENABLE_ANALYTICS=false

## Rate limit, per IP. Defaults: 60 requests per 60000 ms.
# RATE_LIMIT_REQUESTS=60
# RATE_LIMIT_WINDOW=60000

## How long an install count from npm, PyPI or the VS Code marketplace is reused
## before it is fetched again, in seconds. Default 21600 (6 hours). Raising it
## cuts outbound requests; lowering it makes counts fresher.
# INSTALL_CACHE_TTL=21600

## Daily aggregate rows in usage_stats, separate from ENABLE_ANALYTICS.
## "true" to enable. Default off.
# TRACK_USAGE=false

## Country and referrer breakdown per view. Adds a row per view, so it is the
## most expensive option here. "true" to enable. Default off.
# TRACK_BREAKDOWN=false

## Verbose errors in API responses. Leave off in production: it exposes internal
## messages to callers. "true" to enable. Default off.
# DEBUG=false

## Declared in wrangler.toml but not read by any code path yet. Setting it does
## nothing.
# MAX_PROJECTS=100
